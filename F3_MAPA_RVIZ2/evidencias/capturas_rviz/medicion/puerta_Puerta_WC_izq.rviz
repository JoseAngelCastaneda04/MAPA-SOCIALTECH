Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Rejilla 1 m
      Enabled: false
      Cell Size: 1
      Plane Cell Count: 40
      Offset: {X: 0, Y: 0, Z: -0.01}
      Color: 160; 160; 164
      Alpha: 0.4
    - Class: rviz_default_plugins/Map
      Name: Mapa piso 1 cm
      Enabled: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Alpha: 1
      Color Scheme: map
      Draw Behind: false
      Update Topic:
        Value: /map_updates
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
      Use Timestamp: false
    - Class: rviz_default_plugins/Axes
      Name: Ejes del map
      Enabled: false
      Length: 2
      Radius: 0.05
      Reference Frame: <Fixed Frame>
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Cenital (norte arriba)
      Angle: 0
      Scale: 300
      Near Clip Distance: 0.01
      Far Clip Distance: 1000
      X: 11.4
      Y: -5.72
      Invert Z Axis: false
Window Geometry:
  Displays: {collapsed: false}
  Height: 1000
  Width: 1500
  X: 100
  Y: 50

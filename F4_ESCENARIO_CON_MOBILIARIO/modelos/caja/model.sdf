<?xml version="1.0"?>
<!-- F4: obstaculo sencillo de prueba (propio de F4, no existe en SocialTech 2025). Caja 0.40 x 0.40 x 0.50 m. Origen = centro de la base, z=0 = suelo. -->
<sdf version="1.9"><model name="caja"><static>true</static><link name="link"><pose>0 0 0.25  0 0 0</pose>
  <visual name="vis"><geometry><box><size>0.40 0.40 0.50</size></box></geometry><material><ambient>0.8 0.35 0.1 1</ambient><diffuse>0.8 0.35 0.1 1</diffuse></material></visual>
  <collision name="col"><geometry><box><size>0.40 0.40 0.50</size></box></geometry></collision></link></model></sdf>

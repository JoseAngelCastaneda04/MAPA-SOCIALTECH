<?xml version="1.0"?>
<!-- F4: obstaculo sencillo de prueba (propio de F4, no existe en SocialTech 2025). Cilindro r=0.20 m, h=0.60 m. Origen = centro de la base, z=0 = suelo. -->
<sdf version="1.9"><model name="papelera"><static>true</static><link name="link"><pose>0 0 0.3  0 0 0</pose>
  <visual name="vis"><geometry><cylinder><radius>0.20</radius><length>0.60</length></cylinder></geometry><material><ambient>0.2 0.5 0.3 1</ambient><diffuse>0.2 0.5 0.3 1</diffuse></material></visual>
  <collision name="col"><geometry><cylinder><radius>0.20</radius><length>0.60</length></cylinder></geometry></collision></link></model></sdf>

<!-- F4: copia de SocialTech-Gazebo/models/chair (original sin modificar). Origen = centro de la huella, z=0 = suelo.
     Dimensiones medidas de la malla: 0.4806 x 0.5227 x 0.8378 m (X x Y x Z a yaw 0). Colision: simple. -->
<sdf version="1.9">
  <model name="silla">
    <static>true</static>
    <link name="link">
      <visual name="vis"><pose>-0.00000 -0.00345 0.00001 1.570796 0 0</pose><geometry><mesh><uri>meshes/silla.obj</uri></mesh></geometry></visual>
      <collision name="base_estimada"><pose>0 0 0.02 0 0 0</pose><geometry><cylinder><radius>0.25</radius><length>0.04</length></cylinder></geometry></collision>
      <collision name="asiento"><pose>0 -0.0385 0.39 0 0 0</pose><geometry><box><size>0.446 0.439 0.08</size></box></geometry></collision>
      <collision name="respaldo"><pose>0 0.2165 0.635 0 0 0</pose><geometry><box><size>0.388 0.097 0.41</size></box></geometry></collision>
    </link>
  </model>
</sdf>

Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Rejilla 1 m
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
      Offset: {X: 0, Y: 0, Z: -0.01}
      Color: 160; 160; 164
      Alpha: 0.3
    - Class: rviz_default_plugins/Map
      Name: Mapa de ocupacion (F4, estatico)
      Enabled: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Alpha: 0.75
      Color Scheme: map
      Draw Behind: true
      Update Topic:
        Value: /map_updates
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
      Use Timestamp: false
    - Class: rviz_default_plugins/MarkerArray
      Name: Zonas prohibidas (visual) + flechas GT/odom/AMCL + error
      Enabled: true
      Topic:
        Value: /f52/marcadores
        Depth: 20
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/Path
      Name: Camino REAL (Gazebo, verde)
      Enabled: true
      Topic: {Value: /f52/path_gt, Depth: 5, Durability Policy: Volatile, Reliability Policy: Reliable, History Policy: Keep Last}
      Color: 30; 220; 30
      Line Style: Lines
      Line Width: 0.03
    - Class: rviz_default_plugins/Path
      Name: Camino SOLO ODOMETRIA (amarillo)
      Enabled: true
      Topic: {Value: /f52/path_odom, Depth: 5, Durability Policy: Volatile, Reliability Policy: Reliable, History Policy: Keep Last}
      Color: 255; 220; 20
      Line Style: Lines
      Line Width: 0.03
    - Class: rviz_default_plugins/Path
      Name: Camino ESTIMADO AMCL (cian)
      Enabled: true
      Topic: {Value: /f52/path_amcl, Depth: 5, Durability Policy: Volatile, Reliability Policy: Reliable, History Policy: Keep Last}
      Color: 20; 230; 255
      Line Style: Lines
      Line Width: 0.03
    - Class: nav2_rviz_plugins/ParticleCloud
      Name: Particulas AMCL
      Enabled: true
      Topic: {Value: /particle_cloud, Depth: 5, Durability Policy: Volatile, Reliability Policy: Best Effort, History Policy: Keep Last}
      Shape: Arrow (Flat)
      Alpha: 0.5
    - Class: rviz_default_plugins/RobotModel
      Name: TRACER AGV
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Alpha: 0.9
      Collision Enabled: false
      Visual Enabled: true
    - Class: rviz_default_plugins/LaserScan
      Name: LiDAR (/scan) - obstaculos detectados (magenta)
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
      Style: Flat Squares
      Size (m): 0.06
      Color Transformer: FlatColor
      Color: 255; 0; 220
      Alpha: 1
      Decay Time: 0
      Use Fixed Frame: true
      Use rainbow: false
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Marker Scale: 0.6
      Frames:
        All Enabled: false
        map: {Value: true}
        odom: {Value: true}
        base_footprint: {Value: true}
        laser: {Value: true}
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Topic: {Value: /initialpose}
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Cenital (norte arriba)
      Angle: 0
      Scale: 40
      Near Clip Distance: 0.01
      Far Clip Distance: 1000
      X: 11.4
      Y: -5.5
      Invert Z Axis: false
Window Geometry:
  Displays: {collapsed: false}
  Height: 1000
  Width: 1500
  X: 100
  Y: 50

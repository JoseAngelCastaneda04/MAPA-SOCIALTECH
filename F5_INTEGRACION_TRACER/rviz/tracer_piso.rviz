Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Rejilla 1 m
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
      Offset: {X: 0, Y: 0, Z: -0.01}
      Color: 160; 160; 164
      Alpha: 0.4
    - Class: rviz_default_plugins/Map
      Name: Mapa piso amueblado (F4)
      Enabled: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Alpha: 1
      Color Scheme: map
      Draw Behind: true
      Update Topic:
        Value: /map_updates
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
      Use Timestamp: false
    - Class: rviz_default_plugins/RobotModel
      Name: TRACER AGV
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Alpha: 1
      Collision Enabled: false
      Visual Enabled: true
    - Class: rviz_default_plugins/LaserScan
      Name: LiDAR de prueba (/scan)
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
      Style: Flat Squares
      Size (m): 0.04
      Color Transformer: FlatColor
      Color: 255; 40; 40
      Alpha: 1
      Decay Time: 0
      Use Fixed Frame: true
      Use rainbow: false
    - Class: rviz_default_plugins/Odometry
      Name: Odometria (/odom)
      Enabled: true
      Topic:
        Value: /odom
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
      Position Tolerance: 0.1
      Angle Tolerance: 0.2
      Keep: 300
      Shape:
        Value: Arrow
        Alpha: 1
        Color: 40; 200; 40
        Head Length: 0.12
        Head Radius: 0.05
        Shaft Length: 0.25
        Shaft Radius: 0.02
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Marker Scale: 0.6
      Frames:
        All Enabled: false
        map: {Value: true}
        odom: {Value: true}
        base_footprint: {Value: true}
        base_link: {Value: true}
        laser: {Value: true}
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Cenital (norte arriba)
      Angle: 0
      Scale: 40
      Near Clip Distance: 0.01
      Far Clip Distance: 1000
      X: 11.4
      Y: -5.5
      Invert Z Axis: false
Window Geometry:
  Displays: {collapsed: false}
  Height: 1000
  Width: 1500
  X: 100
  Y: 50

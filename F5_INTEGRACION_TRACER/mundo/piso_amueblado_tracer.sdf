<?xml version="1.0"?>
<!-- F5: GENERADO por F5/scripts/generar_mundo.py = mundo de F4 + sensores + TRACER (config/inicio.yaml). No editar a mano. -->
<sdf version="1.9">
  <world name="piso_amueblado">
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <light type="directional" name="sun"><pose>0 0 10 0 0 0</pose><direction>-0.5 0.1 -0.9</direction><diffuse>1 1 1 1</diffuse></light>
    <model name="suelo"><static>true</static><pose>11.5 -5.4 0 0 0 0</pose><link name="l">
      <collision name="c"><geometry><plane><normal>0 0 1</normal><size>26 22</size></plane></geometry></collision>
      <visual name="v"><geometry><plane><normal>0 0 1</normal><size>26 22</size></plane></geometry>
        <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual></link></model>
    <include><name>piso</name><uri>model://piso_designscad_1cm</uri></include>
    <include><name>mesa_1</name><uri>model://mesa1</uri><pose>8.9 -4.9 0 0 0 0.000000</pose></include>
    <include><name>mesa_2</name><uri>model://mesa2</uri><pose>8.9 -6.35 0 0 0 1.570796</pose></include>
    <include><name>silla_N</name><uri>model://silla</uri><pose>8.9 -4.15 0 0 0 0.000000</pose></include>
    <include><name>silla_S</name><uri>model://silla</uri><pose>8.9 -5.65 0 0 0 3.141593</pose></include>
    <include><name>silla_W</name><uri>model://silla</uri><pose>7.75 -4.9 0 0 0 1.570796</pose></include>
    <include><name>silla_E</name><uri>model://silla</uri><pose>10.05 -4.9 0 0 0 -1.570796</pose></include>
    <include><name>caja_1</name><uri>model://caja</uri><pose>10.2 -6.3 0 0 0 0.000000</pose></include>
    <include><name>papelera_1</name><uri>model://papelera</uri><pose>7.55 -6.45 0 0 0 0.000000</pose></include>
    <include><name>tracer</name><uri>model://tracer_agv</uri><pose>9.7000 -2.7000 0.002 0 0 -1.570796</pose></include>
  </world>
</sdf>

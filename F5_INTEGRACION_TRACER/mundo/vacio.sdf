<?xml version="1.0"?>
<!-- F5 prueba 1: TRACER en un mundo vacio (suelo plano + luz + fisica). Solo para validar el modelo. -->
<sdf version="1.9">
  <world name="vacio">
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <light type="directional" name="sun"><pose>0 0 10 0 0 0</pose><direction>-0.5 0.1 -0.9</direction><diffuse>1 1 1 1</diffuse></light>
    <model name="suelo"><static>true</static><link name="l">
      <collision name="c"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry></collision>
      <visual name="v"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual></link></model>
    <include><name>tracer</name><uri>model://tracer_agv</uri><pose>0 0 0.002 0 0 0</pose>
      <!-- VERDAD DE TERRENO solo para medir: pose real del modelo en el mundo (no es el /odom del robot) -->
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_frame>world</odom_frame><robot_base_frame>tracer</robot_base_frame><dimensions>3</dimensions><odom_publish_frequency>100</odom_publish_frequency>
        <odom_topic>/gz/odom_gt</odom_topic><tf_topic>/gz/tf_gt</tf_topic>
      </plugin></include>
  </world>
</sdf>
